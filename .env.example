# Todas son opcionales: sin ellas el sitio usa los datos oficiales de Tu Shopper USA.

# URL pública del sitio (sin "/" al final). Cambia al dominio propio cuando lo vincules en Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp de atención en formato internacional, solo dígitos (57 + número).
