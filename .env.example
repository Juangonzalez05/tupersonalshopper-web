# URL pública del sitio (sin "/" al final). Cambia al dominio propio cuando lo vincules en Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp de atención en formato internacional, solo dígitos (57 + número).
# Vacío = los botones abren WhatsApp sin destinatario para elegir el contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Usuario de Instagram sin "@". Vacío = el enlace va a instagram.com.
NEXT_PUBLIC_INSTAGRAM_USER=
